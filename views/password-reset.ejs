<%- include('partials/header') %>
<div class="page-head"><div class="wrap"><h1>Neues Passwort festlegen</h1></div></div>
<section class="block">
  <div class="wrap tinywrap">
    <div class="form-card">
      <% if (error) { %><div class="flash error" style="margin:0 0 16px"><%= error %></div><% } %>
      <form method="post" action="/passwort-zuruecksetzen" data-validate>
        <input type="hidden" name="token" value="<%= token %>">
        <div class="field"><label>Neues Passwort</label><input type="password" name="password" required autofocus minlength="8"><div class="form-note">Mind. 8 Zeichen mit Groß- und Kleinbuchstaben, einer Zahl und einem Sonderzeichen.</div></div>
        <div class="field"><label>Neues Passwort wiederholen</label><input type="password" name="password2" required></div>
        <button class="btn btn-accent btn-block" type="submit">Passwort speichern</button>
      </form>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
