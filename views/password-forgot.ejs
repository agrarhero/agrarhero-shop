<%- include('partials/header') %>
<div class="page-head"><div class="wrap"><div class="crumb"><a href="/login">Anmelden</a> › Passwort vergessen</div><h1>Passwort vergessen</h1></div></div>
<section class="block">
  <div class="wrap tinywrap">
    <div class="form-card">
      <% if (sent) { %>
        <p style="line-height:1.7">Falls für <strong><%= email %></strong> ein Konto existiert, haben wir eine E-Mail mit einem Link zum Zurücksetzen gesendet. Bitte prüfen Sie Ihr Postfach – der Link ist 1 Stunde gültig.</p>
        <a class="btn btn-line btn-block" href="/login" style="margin-top:16px">Zurück zur Anmeldung</a>
      <% } else { %>
        <p style="color:var(--muted);margin-bottom:16px">Geben Sie Ihre E-Mail-Adresse ein. Wir senden Ihnen einen Link, um ein neues Passwort festzulegen.</p>
        <form method="post" action="/passwort-vergessen" data-validate>
          <div class="field"><label>E-Mail</label><input type="email" name="email" required autofocus></div>
          <button class="btn btn-accent btn-block" type="submit">Link senden</button>
        </form>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
