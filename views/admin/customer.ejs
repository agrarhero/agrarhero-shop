<%- include('../partials/admin-header') %>
<div style="margin-bottom:8px"><a href="/admin/kunden" style="color:var(--muted);font-size:.88rem">‹ Zurück zur Kundenliste</a></div>
<div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:20px;flex-wrap:wrap;gap:12px">
  <div>
    <h1 style="font-size:2rem"><%= (cust.first_name||'')+' '+(cust.last_name||'') %></h1>
    <p style="color:var(--muted);font-size:.9rem">Kunden-Nr. <%= cust.id %> · registriert am <%= h.dateDE(cust.created_at) %>
      · <span class="badge <%= cust.customer_type==='privat'?'b-grey':'b-blue' %>" style="font-size:.68rem"><%= cust.customer_type==='privat'?'Privatkunde':'Firmenkunde' %></span></p>
  </div>
  <% if (cust.verified) { %><span class="badge b-green">E-Mail bestätigt</span><% } else { %><span class="badge b-orange">E-Mail offen</span><% } %>
</div>

<div class="risk-panel risk-<%= risk.level %>" id="sicherheit">
  <div class="risk-head">
    <div class="risk-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v5c0 4.4-3 8.2-7 9-4-.8-7-4.6-7-9V6l7-3z"/><% if (risk.level==='ok') { %><path d="M9 12l2 2 4-4"/><% } else { %><path d="M12 8v5"/><path d="M12 16.5h.01"/><% } %></svg>
      <div><h2>Sicherheits-Check</h2><span>Fake-/Troll-Risiko dieses Kunden</span></div>
    </div>
    <span class="risk-badge rb-<%= risk.level %>"><%= risk.level==='bad' ? 'Erhöhtes Risiko' : (risk.level==='warn' ? 'Leicht auffällig' : 'Unauffällig') %></span>
  </div>
  <p class="risk-sum"><%= risk.summary %></p>
  <div class="risk-grid">
    <% risk.signals.forEach(function(sg){ %>
      <div class="risk-item lvl-<%= sg.level %>">
        <div class="ri-top"><span class="ri-dot"></span><span class="ri-label"><%= sg.label %></span><span class="ri-val"><%= sg.value %></span></div>
        <p class="ri-text"><%= sg.text %></p>
      </div>
    <% }) %>
  </div>
  <p class="risk-note"><strong>Was ist das?</strong> Eine Einschätzung, wie wahrscheinlich es sich um eine Troll-/Fake-Bestellung handelt – rein als Hilfe, es erfolgt <strong>keine</strong> automatische Sperre. Die „Herkunft“ wird über den Referrer erkannt (die Seite, von der der Besucher kam); Cookies fremder Seiten sind aus Browser-Sicherheitsgründen technisch nicht auslesbar. Die beobachteten Domains pflegst du unter <a href="/admin/einstellungen">Einstellungen</a>.</p>
</div>

<div class="panel" style="margin-bottom:22px">
  <div class="phead"><h2>Herkunft &amp; Aktivität</h2></div>
  <div class="hkft-grid">
    <div class="hkft-item">
      <div class="hkft-lbl">Kam über</div>
      <div><span class="orig-badge orig-<%= origin.kind %>"><%= origin.label %></span></div>
      <div class="hkft-detail"><%= origin.detail %></div>
      <div class="hkft-note">Nur zur Information &ndash; beeinflusst den Sicherheits-Check nicht.</div>
    </div>
    <div class="hkft-item">
      <div class="hkft-lbl">Herkunft (IP-Adresse)</div>
      <% if (cust.last_ip) { %>
        <div><span style="font-size:1.05rem"><%= geo.flag(cust.geo_country_code) || '🏳️' %></span> <strong><%= cust.geo_country || (geo.isPrivate(cust.last_ip) ? 'Lokal / privat' : '—') %></strong><% if (cust.geo_region) { %> · <%= cust.geo_region %><% } %></div>
        <div class="hkft-detail" style="font-family:monospace"><%= cust.last_ip %></div>
      <% } else { %><div class="hkft-detail">— (noch keine Aktivität)</div><% } %>
    </div>
    <div class="hkft-item">
      <div class="hkft-lbl">Aktivität</div>
      <% if (typeof live !== 'undefined' && live) { %>
        <div class="cust-live"><span class="cust-live-dot"></span> <span style="color:var(--muted)">Gerade auf:</span> <strong><%= live.label %></strong> <span style="color:var(--muted)">· seit <span class="live-sec" data-since="<%= live.since %>">0:00</span></span></div>
        <div class="hkft-detail" style="font-family:monospace"><%= live.url %></div>
      <% } else { %>
        <div><span style="color:var(--muted)">Aktueller Status:</span> <strong>gerade nicht online</strong></div>
      <% } %>
      <div><span style="color:var(--muted)">Zuletzt aktiv:</span> <strong><%= cust.last_seen ? h.dateTimeDE(cust.last_seen) : '—' %></strong></div>
      <div><span style="color:var(--muted)">Letzter Login:</span> <strong><%= cust.last_login ? h.dateTimeDE(cust.last_login) : '—' %></strong></div>
    </div>
  </div>
</div>

<div class="admin-grid">
  <div>
    <div class="panel" style="margin-bottom:20px">
      <div class="phead"><h2>Stammdaten</h2></div>
      <div style="padding:16px 20px;font-size:.92rem;line-height:1.9">
        <% if (cust.company){ %><strong><%= cust.company %></strong><br><% } %>
        <%= (cust.salutation? cust.salutation+' ':'') + (cust.first_name||'')+' '+(cust.last_name||'') %><br>
        <% if (cust.ustid){ %><span style="color:var(--muted)">USt-IdNr.:</span> <%= cust.ustid %><br><% } %>
        <%= cust.street || '—' %><br>
        <%= (cust.zip||'')+' '+(cust.city||'') %><br>
        <%= cust.country || '' %><br>
        <span style="color:var(--muted)">E-Mail:</span> <%= cust.email %><br>
        <span style="color:var(--muted)">Telefon:</span> <%= cust.phone || '—' %>
      </div>
    </div>

    <div class="panel" style="margin-bottom:20px">
      <div class="phead"><h2>Aktueller Warenkorb</h2>
        <% if (cartInfo && cartInfo.updated) { %><span style="font-size:.78rem;color:var(--muted)">Stand: <%= h.dateDE(cartInfo.updated) %></span><% } %>
      </div>
      <% if (!cartInfo || cartInfo.items.length === 0) { %>
        <div style="padding:24px 20px;color:var(--muted)">Der Warenkorb ist derzeit leer.</div>
      <% } else { %>
        <table class="tbl">
          <thead><tr><th>Produkt</th><th class="c">Menge</th><th class="r">Einzel</th><th class="r">Summe</th></tr></thead>
          <tbody>
          <% cartInfo.items.forEach(function(it){ %>
            <tr><td><%= it.name %><div style="font-size:.8rem;color:var(--muted)"><%= it.type %></div></td>
            <td class="c"><%= it.quantity %></td><td class="r"><%= h.euro(it.unit_cents) %></td><td class="r"><%= h.euro(it.unit_cents*it.quantity) %></td></tr>
          <% }) %>
          </tbody>
        </table>
        <div style="padding:12px 20px;border-top:1px solid var(--line);display:flex;justify-content:space-between;font-weight:600">
          <span>Warenkorb-Summe (brutto)</span><span><%= h.euro(cartInfo.totals.gross) %></span>
        </div>
        <p class="form-note" style="padding:0 20px 14px;margin:0">Live-Stand – zum Aktualisieren die Seite neu laden.</p>
      <% } %>
    </div>

    <div class="panel">
      <div class="phead"><h2>Bestellungen (<%= orders.length %>)</h2></div>
      <% if (orders.length === 0) { %>
        <div style="padding:30px 20px;color:var(--muted)">Dieser Kunde hat noch keine Bestellung aufgegeben.</div>
      <% } else { %>
      <table class="tbl">
        <thead><tr><th>Bestellung</th><th>Datum</th><th class="r">Betrag</th><th>Status</th><th></th></tr></thead>
        <tbody>
        <% orders.forEach(function(o){ var col = stat.color(o.status); %>
          <tr class="<%= col ? 'row-'+col : '' %>">
            <td style="font-weight:600"><%= o.order_number %></td>
            <td><%= h.dateTimeDE(o.created_at) %></td>
            <td class="r"><%= h.euro(o.totals.gross) %></td>
            <td><span class="badge b-<%= col || 'grey' %>"><%= stat.label(o.status) %></span></td>
            <td class="r"><a class="btn btn-line btn-sm" href="/admin/bestellung/<%= o.id %>">Öffnen</a></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <div>
    <% if (orders.length === 0) { %>
    <div class="panel" style="margin-bottom:20px">
      <div class="phead"><h2>Willkommens-Mail</h2></div>
      <div style="padding:18px 20px">
        <% if (cust.welcome_sent_at) { %>
          <p style="margin:0 0 10px"><span class="badge b-green">gesendet</span> am <%= String(cust.welcome_sent_at).replace('T',' ').slice(0,16) %> Uhr</p>
          <p class="form-note" style="margin:0 0 14px">Eine Begr&uuml;&szlig;ungs-Mail wurde bereits verschickt. Bei Bedarf k&ouml;nnen Sie sie erneut senden.</p>
          <form method="post" action="/admin/kunden/<%= cust.id %>/willkommen"><button class="btn btn-line btn-block" type="submit">Willkommens-Mail erneut senden</button></form>
        <% } else { %>
          <p class="form-note" style="margin:0 0 14px">Dieser Kunde hat sich registriert, aber noch nicht bestellt. Senden Sie eine seri&ouml;se Begr&uuml;&szlig;ungs-Mail: Danke f&uuml;r die Registrierung, das Konto ist aktiv und der Shop kann voll genutzt werden.</p>
          <form method="post" action="/admin/kunden/<%= cust.id %>/willkommen"><button class="btn btn-accent btn-block" type="submit">Willkommens-Mail senden</button></form>
        <% } %>
      </div>
    </div>
    <% } %>
    <div class="panel" style="margin-bottom:20px">
      <div class="phead"><h2>Zahlungsart</h2></div>
      <div style="padding:18px 20px">
        <p style="margin:0 0 10px">Kauf auf Rechnung:
          <% if (cust.invoice_allowed) { %><span class="badge b-green">freigeschaltet</span><% } else { %><span class="badge b-grey">nur Vorkasse</span><% } %>
        </p>
        <p class="form-note" style="margin:0 0 14px">Standardmäßig zahlt jeder Kunde per <strong>Vorkasse</strong>. Erst nach Ihrer manuellen Freigabe kann dieser Kunde an der Kasse „Kauf auf Rechnung" wählen.</p>
        <% if (cust.invoice_allowed) { %>
          <form method="post" action="/admin/kunden/<%= cust.id %>/rechnung"><input type="hidden" name="allow" value="0"><button class="btn btn-line btn-block" type="submit">Rechnungskauf sperren (nur Vorkasse)</button></form>
        <% } else { %>
          <form method="post" action="/admin/kunden/<%= cust.id %>/rechnung"><input type="hidden" name="allow" value="1"><button class="btn btn-accent btn-block" type="submit">Kauf auf Rechnung freischalten</button></form>
        <% } %>
      </div>
    </div>
    <div class="panel" style="margin-bottom:20px">
      <div class="phead"><h2>Mindestbestellmenge</h2></div>
      <div style="padding:18px 20px">
        <p style="margin:0 0 10px">Status:
          <% if (cust.min_order_waived) { %><span class="badge b-green">aufgehoben</span><% } else { %><span class="badge b-grey">Standard gilt</span><% } %>
        </p>
        <p class="form-note" style="margin:0 0 14px">Standardm&auml;&szlig;ig gilt die im Shop hinterlegte Mindestbestellmenge. Heben Sie sie f&uuml;r diesen Kunden auf, kann er beliebige St&uuml;ckzahlen bestellen &ndash; nur f&uuml;r dieses Konto.</p>
        <% if (cust.min_order_waived) { %>
          <form method="post" action="/admin/kunden/<%= cust.id %>/mindestmenge"><input type="hidden" name="waive" value="0"><button class="btn btn-line btn-block" type="submit">Mindestmenge wieder aktivieren</button></form>
        <% } else { %>
          <form method="post" action="/admin/kunden/<%= cust.id %>/mindestmenge"><input type="hidden" name="waive" value="1"><button class="btn btn-accent btn-block" type="submit">Mindestmenge f&uuml;r diesen Kunden aufheben</button></form>
        <% } %>
      </div>
    </div>
    <div class="panel" style="border-color:#f0d9d2">
      <div class="phead"><h2>Moderation</h2></div>
      <div style="padding:18px 20px">
        <form method="post" action="/admin/kunden/<%= cust.id %>/loeschen-bannen" id="banForm">
          <input type="hidden" name="confirm" value="ja">
          <button class="btn btn-block" style="background:#c0392b;color:#fff" type="button" onclick="gbOpenBan()">Löschen und Bannen</button>
        </form>
        <p class="form-note" style="margin:12px 0 0">Entfernt Konto + alle Bestellungen und sperrt die E-Mail dauerhaft. Der Kunde wird nicht informiert.</p>
      </div>
    </div>
  </div>
</div>

<style>
  #banModal{position:fixed;inset:0;background:rgba(15,18,22,.62);display:none;align-items:center;justify-content:center;z-index:99999;padding:20px}
  #banModal.open{display:flex}
  #banModal .gb-box{background:#fff;border-radius:14px;max-width:460px;width:100%;padding:32px;text-align:center;box-shadow:0 40px 90px -20px rgba(0,0,0,.6);animation:gbpop .16s ease-out}
  @keyframes gbpop{from{transform:scale(.94);opacity:0}to{transform:scale(1);opacity:1}}
  #banModal .gb-ic{font-size:2.6rem;line-height:1;margin-bottom:8px}
  #banModal h3{font-family:'Barlow Condensed','Inter',sans-serif;font-size:1.55rem;margin:0 0 12px;color:#14171c}
  #banModal p{color:#6b7280;line-height:1.6;font-size:.96rem;margin:0}
  #banModal .gb-acts{display:flex;gap:12px;margin-top:26px}
  #banModal .gb-acts button{flex:1;padding:.85rem 1rem;border-radius:6px;font-weight:600;font-size:.98rem;cursor:pointer;font-family:'Inter',sans-serif}
  #banModal .gb-cancel{background:#fff;border:1px solid #d5d9df;color:#14171c}
  #banModal .gb-ok{background:#c0392b;border:1px solid #c0392b;color:#fff}
  body.gb-noscroll{overflow:hidden}
</style>
<div id="banModal" role="dialog" aria-modal="true" onclick="if(event.target===this)gbCloseBan()">
  <div class="gb-box">
    <div class="gb-ic">⚠️</div>
    <h3>Wirklich löschen und bannen?</h3>
    <p>Das Kundenkonto <strong><%= cust.email %></strong> wird mit <strong>allen Bestellungen</strong> gelöscht und die
    E-Mail-Adresse <strong>dauerhaft gesperrt</strong>. Diese Aktion kann nicht rückgängig gemacht werden.</p>
    <div class="gb-acts">
      <button type="button" class="gb-cancel" onclick="gbCloseBan()">Abbrechen</button>
      <button type="button" class="gb-ok" onclick="document.getElementById('banForm').submit()">Ja, endgültig löschen</button>
    </div>
  </div>
</div>
<script>
  function gbOpenBan(){ document.getElementById('banModal').classList.add('open'); document.body.classList.add('gb-noscroll'); }
  function gbCloseBan(){ document.getElementById('banModal').classList.remove('open'); document.body.classList.remove('gb-noscroll'); }
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') gbCloseBan(); });
</script>
<style>
  .cust-live{margin-bottom:2px}
  .cust-live-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#4a9b2f;margin-right:5px;vertical-align:middle}
  .cust-live .live-sec{font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
</style>
<script>
  (function(){ function t(){ var now=Date.now(); document.querySelectorAll('.live-sec').forEach(function(el){ var s0=parseInt(el.getAttribute('data-since'),10); if(!s0){el.textContent='—';return;} var s=Math.max(0,Math.floor((now-s0)/1000)); el.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0'); }); } t(); setInterval(t,1000); })();
</script>
<%- include('../partials/admin-footer') %>
