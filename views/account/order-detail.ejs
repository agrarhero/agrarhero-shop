<%- include('../partials/header') %>
<% var ship = h.orderShipping(order); %>
<% var cur = stat.customerStep(order.status); var cc = stat.customerColor(order.status); %>
<% var _steps = stat.CUSTOMER_STEPS.length; var _fill = _steps > 1 ? (Math.max(0, Math.min(cur, _steps - 1)) / (_steps - 1) * 84).toFixed(1) : 0; %>
<div class="page-head"><div class="wrap"><div class="crumb"><a href="/konto">Mein Konto</a> › <a href="/konto/bestellungen">Bestellungen</a> › <%= order.order_number %></div><h1>Bestellung <%= order.order_number %></h1></div></div>

<section class="block">
  <div class="wrap">
    <div class="acct-layout">
      <%- include('../partials/account-nav') %>
      <div class="acct-content">

        <div class="od2-head">
          <div>
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
              <strong style="font-size:1.15rem;font-family:'Poppins'"><%= order.order_number %></strong>
              <span class="badge b-<%= cc %>"><%= stat.customerLabel(order.status) %></span>
            </div>
            <div style="color:var(--muted);font-size:.88rem;margin-top:5px">Bestellt am <%= h.dateTimeDE(order.created_at) %><% if (stat.customerNote(order.status)) { %> · <span style="color:#a5540f"><%= stat.customerNote(order.status) %></span><% } %></div>
          </div>
          <div class="od2-total">
            <div class="l">Gesamt</div>
            <div class="n"><%= h.euro(totals.gross) %></div>
            <% if (order.invoice_sent_at) { %><a class="btn btn-dark btn-sm" style="margin-top:10px" href="/konto/rechnung/<%= order.order_number %>.pdf" target="_blank">Rechnung (PDF)</a><% } %>
          </div>
        </div>

        <div class="panel" style="padding:26px 22px;margin-bottom:16px">
          <div class="timeline">
            <div class="tl-fill" style="width:<%= _fill %>%"></div>
            <% stat.CUSTOMER_STEPS.forEach(function(label,i){ var clx = i<cur?'done':(i===cur?'active':''); %>
              <div class="tl-step <%= clx %>">
                <div class="tl-dot"><%= i<cur ? '✓' : (i+1) %></div>
                <div class="tl-label"><%= label %></div>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="panel" style="margin-bottom:16px">
          <div class="phead"><h2>Artikel</h2></div>
          <div class="oc-items" style="padding:4px 14px">
            <% items.forEach(function(it){ var link = it.product_slug ? ('/produkt/'+it.product_slug) : null; %>
              <% if (link) { %><a class="oc-item" href="<%= link %>"><% } else { %><div class="oc-item nolink"><% } %>
                <span class="oc-thumb"><% if (it.product_image) { %><img src="/img/products/<%= it.product_image %>" alt="<%= it.name %>"><% } else { %><span class="mini-crate"></span><% } %></span>
                <span class="oc-info"><span class="oc-name"><%= it.name %></span><% if (it.type) { %><span class="oc-type"><%= it.type %></span><% } %></span>
                <span class="oc-qty"><%= it.quantity %>&times;</span>
                <span class="oc-price"><%= h.euro(it.unit_cents * it.quantity) %></span>
              <% if (link) { %></a><% } else { %></div><% } %>
            <% }) %>
          </div>
          <div style="padding:14px 22px;border-top:1px solid var(--line)">
            <div class="summary" style="border:none;background:none;padding:0;max-width:320px;margin-left:auto">
              <div class="line"><span>Zwischensumme (netto)</span><span><%= h.euro(totals.subtotal) %></span></div>
              <div class="line"><span>Versand</span><span><% if (totals.shipping > 0) { %><%= h.euro(totals.shipping) %><% } else { %><span class="ship-free">kostenlos</span><% } %></span></div>
              <div class="line"><span>zzgl. <%= totals.taxRate %> % MwSt.</span><span><%= h.euro(totals.tax) %></span></div>
              <div class="line total"><span>Gesamt</span><span><%= h.euro(totals.gross) %></span></div>
            </div>
          </div>
        </div>

        <div class="od2-info">
          <div class="od2-card">
            <h3>Lieferadresse<% if (ship.different) { %> (abweichend)<% } %></h3>
            <div style="font-size:.9rem;line-height:1.8">
              <% if (ship.company){ %><strong><%= ship.company %></strong><br><% } %>
              <%= (ship.first_name+' '+ship.last_name).trim() %><br>
              <%= ship.street %><br>
              <%= (ship.zip+' '+ship.city).trim() %><br>
              <%= ship.country %>
              <% if (ship.different) { %>
                <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--line)">
                  <span style="color:var(--muted);font-size:.8rem">Rechnungsadresse</span><br>
                  <% if (order.cust_company){ %><%= order.cust_company %><br><% } %>
                  <%= ((order.cust_first_name||'')+' '+(order.cust_last_name||'')).trim() %><br>
                  <%= order.cust_street || '' %>, <%= ((order.cust_zip||'')+' '+(order.cust_city||'')).trim() %>
                </div>
              <% } %>
              <div style="margin-top:8px;color:var(--muted)"><%= order.cust_email %><% if (order.cust_phone) { %> · <%= order.cust_phone %><% } %></div>
            </div>
          </div>
          <div class="od2-card">
            <h3>Zahlung &amp; Versand</h3>
            <div style="font-size:.9rem;line-height:1.95">
              <span style="color:var(--muted)">Zahlungsart</span> <%= order.payment_method === 'rechnung' ? 'Kauf auf Rechnung' : 'Vorkasse – Rechnung per E-Mail' %><br>
              <% if (order.invoice_sent_at) { %>
                <span style="color:var(--muted)">Rechnung versendet</span> <%= h.dateTimeDE(order.invoice_sent_at) %><br>
                <span style="color:var(--muted)">Zahlungsziel</span> <%= order.payment_days || '14' %> Werktage<br>
              <% } else { %>
                <span style="color:var(--muted)">Status</span> Rechnung folgt nach Prüfung per E-Mail<br>
              <% } %>
              <span style="color:var(--muted)">Lieferung</span> <%= order.delivery_days || '3-6' %> Werktage nach Zahlungseingang
            </div>
          </div>
        </div>

        <div style="margin-top:18px"><a class="btn btn-line" href="/konto/bestellungen">‹ Zurück zu meinen Bestellungen</a></div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
