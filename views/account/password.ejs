<%- include('../partials/header') %>
<div class="page-head"><div class="wrap"><div class="crumb"><a href="/konto">Mein Konto</a> › Passwort ändern</div><h1>Passwort ändern</h1></div></div>
<section class="block">
  <div class="wrap">
    <div class="acct-layout">
      <%- include('../partials/account-nav') %>
      <div class="acct-content">
        <div class="form-card" style="max-width:520px">
          <% if (pwError) { %><div class="flash error" style="margin:0 0 14px"><%= pwError %></div><% } %>
          <% if (pwOk) { %><div class="flash success" style="margin:0 0 14px"><%= pwOk %></div><% } %>
          <form method="post" action="/konto/passwort" data-validate>
            <div class="field"><label>Aktuelles Passwort</label><input type="password" name="current" required></div>
            <div class="field"><label>Neues Passwort</label><input type="password" name="new" required minlength="8"><div class="form-note">Mind. 8 Zeichen mit Groß- und Kleinbuchstaben, einer Zahl und einem Sonderzeichen.</div></div>
            <div class="field"><label>Neues Passwort wiederholen</label><input type="password" name="new2" required></div>
            <button class="btn btn-dark btn-block" type="submit">Passwort ändern</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
