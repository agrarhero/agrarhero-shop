<%- include('../partials/header') %>
<%
  var __hr = Number(new Intl.DateTimeFormat('de-DE', { hour: 'numeric', hour12: false, timeZone: 'Europe/Berlin' }).format(new Date()));
  var greeting = __hr < 11 ? 'Guten Morgen' : (__hr < 18 ? 'Guten Tag' : 'Guten Abend');
  var displayName = (user.customer_type !== 'privat' && user.company) ? user.company : (user.first_name ? (user.first_name + ' ' + (user.last_name || '')).trim() : user.email);
  var ordVolume = orders.reduce(function(s,o){ return s + (o.totals ? o.totals.gross : 0); }, 0);
  var ordOpen = orders.filter(function(o){ return ['versendet','zugestellt','storniert'].indexOf(o.status) === -1; }).length;
%>
<div class="page-head"><div class="wrap"><div class="crumb">Mein Konto</div><h1>Übersicht</h1></div></div>
<section class="block">
  <div class="wrap">
    <div class="acct-layout">
      <%- include('../partials/account-nav') %>
      <div class="acct-content">

        <div class="nd-head">
          <span class="nd-av"><%= (user.first_name || user.email || '?').slice(0,1).toUpperCase() %></span>
          <div class="nd-hi">
            <div class="greet"><%= greeting %></div>
            <h2><%= displayName %></h2>
            <div class="sub"><%= user.customer_type === 'privat' ? 'Privatkunde' : 'Firmenkunde' %><% if (user.first_name) { %> · <%= (user.first_name + ' ' + (user.last_name||'')).trim() %><% } %></div>
          </div>
          <div class="nd-pills">
            <span class="nd-pill">Kundennr. <strong><%= user.customer_number || '—' %></strong></span>
            <span class="nd-pill">Kunde seit <strong><%= h.dateDE(user.created_at) %></strong></span>
          </div>
        </div>

        <div class="nd-metrics">
          <div class="nd-metric is-accent"><div class="m-l">Bestellungen</div><div class="m-n"><%= orders.length %></div></div>
          <div class="nd-metric"><div class="m-l">In Bearbeitung</div><div class="m-n"><%= ordOpen %></div></div>
          <div class="nd-metric"><div class="m-l">Bestellvolumen</div><div class="m-n"><%= h.euro(ordVolume) %></div></div>
        </div>

        <div class="nd-sec-title">Schnellzugriff</div>
        <div class="nd-qa">
          <a href="/konto/bestellungen"><span class="qa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 7l9-4 9 4-9 4-9-4Z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11.2V21"/></svg></span><span class="qa-t">Meine Bestellungen</span><span class="qa-ar">›</span></a>
          <a href="/konto/daten"><span class="qa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></span><span class="qa-t">Meine Daten</span><span class="qa-ar">›</span></a>
          <a href="/konto/passwort"><span class="qa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><span class="qa-t">Passwort ändern</span><span class="qa-ar">›</span></a>
          <a href="/produkte"><span class="qa-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/><path d="M2 3h3l2.4 12.2a1.5 1.5 0 0 0 1.5 1.2h8.7a1.5 1.5 0 0 0 1.5-1.2L22 7H6"/></svg></span><span class="qa-t">Weiter einkaufen</span><span class="qa-ar">›</span></a>
        </div>

        <% if (orders.length) { %>
          <div class="nd-sec-title">Letzte Bestellung</div>
          <%- include('../partials/order-card', { o: orders[0], stat: stat }) %>
          <% if (orders.length > 1) { %><div style="text-align:center;margin-top:14px"><a class="btn btn-line" href="/konto/bestellungen">Alle Bestellungen ansehen ▸</a></div><% } %>
        <% } else { %>
          <div class="acct-empty">
            <div class="mini-crate" style="margin:0 auto 14px"></div>
            <p>Sie haben noch keine Bestellungen.</p>
            <a class="btn btn-accent" href="/produkte">Zum Sortiment ▸</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
