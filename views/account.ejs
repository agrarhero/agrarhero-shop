<%- include('partials/header') %>
<div class="page-head">
  <div class="wrap" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px">
    <div><div class="crumb">Mein Konto</div><h1>Hallo <%= user.first_name || user.email %></h1></div>
    <form method="post" action="/logout"><button class="btn btn-line btn-sm" type="submit">Abmelden</button></form>
  </div>
</div>

<section class="block">
  <div class="wrap">
    <div class="admin-grid">
      <div>
        <div class="section-title" style="margin-top:0">Meine Bestellungen</div>
        <% if (orders.length === 0) { %>
          <div class="panel" style="padding:40px;text-align:center;color:var(--muted)">
            Sie haben noch keine Bestellungen. <a href="/produkte" style="color:var(--accent);font-weight:600">Jetzt stöbern ▸</a>
          </div>
        <% } else { %>
          <div class="panel" style="padding:6px 10px">
            <table class="tbl">
              <thead><tr><th>Bestellung</th><th>Datum</th><th class="c">Artikel</th><th class="r">Betrag</th><th>Status</th><th></th></tr></thead>
              <tbody>
              <% orders.forEach(function(o){ var cc = stat.customerColor(o.status); %>
                <tr>
                  <td style="font-weight:600"><%= o.order_number %></td>
                  <td><%= h.dateDE(o.created_at) %></td>
                  <td class="c"><%= o.itemCount %></td>
                  <td class="r"><%= h.euro(o.totals.gross) %></td>
                  <td>
                    <span class="badge b-<%= cc %>"><%= stat.customerLabel(o.status) %></span>
                    <% if (stat.customerNote(o.status)) { %><div style="font-size:.72rem;color:var(--muted);margin-top:3px"><%= stat.customerNote(o.status) %></div><% } %>
                  </td>
                  <td class="r" style="white-space:nowrap">
                    <a class="btn btn-line btn-sm" href="/bestellung/<%= o.order_number %>">Details</a>
                    <% if (o.invoice_sent_at) { %><a class="btn btn-dark btn-sm" href="/konto/rechnung/<%= o.order_number %>.pdf" target="_blank">Rechnung</a><% } %>
                  </td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <div class="section-title">Passwort ändern</div>
        <div class="form-card">
          <% if (pwError) { %><div class="flash error" style="margin:0 0 14px"><%= pwError %></div><% } %>
          <% if (pwOk) { %><div class="flash success" style="margin:0 0 14px"><%= pwOk %></div><% } %>
          <form method="post" action="/konto/passwort">
            <div class="field"><label>Aktuelles Passwort</label><input type="password" name="current" required></div>
            <div class="grid2">
              <div class="field"><label>Neues Passwort</label><input type="password" name="new" required></div>
              <div class="field"><label>Neues Passwort wiederholen</label><input type="password" name="new2" required></div>
            </div>
            <button class="btn btn-dark btn-block" type="submit">Passwort ändern</button>
          </form>
        </div>
      </div>

      <div>
        <div class="section-title" style="margin-top:0">Meine Daten</div>
        <div class="form-card">
          <form method="post" action="/konto/daten">
            <div class="grid2">
              <div class="field"><label>Vorname</label><input name="first_name" value="<%= user.first_name || '' %>"></div>
              <div class="field"><label>Nachname</label><input name="last_name" value="<%= user.last_name || '' %>"></div>
            </div>
            <div class="field"><label>Firma</label><input name="company" value="<%= user.company || '' %>"></div>
            <div class="field"><label>Straße & Nr.</label><input name="street" value="<%= user.street || '' %>"></div>
            <div class="grid2">
              <div class="field"><label>PLZ</label><input name="zip" value="<%= user.zip || '' %>"></div>
              <div class="field"><label>Ort</label><input name="city" value="<%= user.city || '' %>"></div>
            </div>
            <div class="grid2">
              <div class="field"><label>Land</label><input name="country" value="<%= user.country || 'Deutschland' %>"></div>
              <div class="field"><label>Telefon</label><input name="phone" value="<%= user.phone || '' %>"></div>
            </div>
            <button class="btn btn-dark btn-block" type="submit">Speichern</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
