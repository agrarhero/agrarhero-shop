<div class="order-card">
  <div class="oc-head">
    <div class="oc-meta">
      <div class="ocm"><span>Bestellnummer</span><strong class="oc-nr"><%= o.order_number %></strong></div>
      <div class="ocm"><span>Bestelldatum</span><strong><%= h.dateDE(o.created_at) %></strong></div>
      <div class="ocm"><span>Bestelluhrzeit</span><strong><%= h.timeDE(o.created_at) %></strong></div>
    </div>
    <span class="badge b-<%= stat.customerColor(o.status) %>"><%= stat.customerLabel(o.status) %></span>
  </div>
  <div class="oc-items">
    <% o.items.forEach(function(it){ var link = it.product_slug ? ('/produkt/'+it.product_slug) : null; %>
      <% if (link) { %><a class="oc-item" href="<%= link %>"><% } else { %><div class="oc-item nolink"><% } %>
        <span class="oc-thumb"><% if (it.product_image) { %><img src="/img/products/<%= it.product_image %>" alt="<%= it.name %>"><% } else { %><span class="mini-crate"></span><% } %></span>
        <span class="oc-info">
          <span class="oc-name"><%= it.name %></span>
          <% if (it.type) { %><span class="oc-type"><%= it.type %></span><% } %>
        </span>
        <span class="oc-qty"><%= it.quantity %>&times;</span>
        <span class="oc-price"><%= h.euro(it.unit_cents * it.quantity) %></span>
      <% if (link) { %></a><% } else { %></div><% } %>
    <% }) %>
  </div>
  <div class="oc-foot">
    <div class="oc-note"><% if (stat.customerNote(o.status)) { %><span class="dotwarn"></span> <%= stat.customerNote(o.status) %><% } %></div>
    <div class="oc-right">
      <span class="oc-total">Gesamt <strong><%= h.euro(o.totals.gross) %></strong></span>
      <a class="btn btn-line btn-sm" href="/konto/bestellungen/<%= o.order_number %>">Details</a>
      <% if (o.invoice_sent_at) { %><a class="btn btn-dark btn-sm" href="/konto/rechnung/<%= o.order_number %>.pdf" target="_blank">Rechnung</a><% } %>
    </div>
  </div>
</div>
