<script>
// Live-Praesenz: sanfter Heartbeat, damit "gerade online" im Admin stimmt.
// Pausiert bei verstecktem Tab; sendet sofort beim Zurueckkehren.
(function(){
  var INTERVAL = 60000, last = 0, timer = null;
  function ping(){
    if (document.visibilityState !== 'visible') return;
    last = Date.now();
    try { fetch('/aktiv', { method:'GET', cache:'no-store', keepalive:true }).catch(function(){}); } catch(e){}
  }
  function start(){ if (timer) return; ping(); timer = setInterval(ping, INTERVAL); }
  function stop(){ if (timer){ clearInterval(timer); timer = null; } }
  document.addEventListener('visibilitychange', function(){
    if (document.visibilityState === 'visible'){ if (Date.now()-last > 30000) ping(); start(); }
    else stop();
  });
  start();
})();
</script>
<!-- Cookie-Hinweis (nur technisch notwendige Cookies) -->
<div class="cookie-bar" id="cookieBar" hidden>
  <div class="cookie-inner">
    <span class="cookie-txt">Wir verwenden nur <strong>technisch notwendige Cookies</strong>, damit Login und Warenkorb funktionieren. Mehr dazu in der <a href="/datenschutz">Datenschutzerkl&auml;rung</a>.</span>
    <button type="button" class="cookie-ok" id="cookieOk">Akzeptieren</button>
  </div>
</div>
<script>
(function(){
  try{ if(localStorage.getItem('gb-cookie-ok')==='1') return; }catch(e){}
  var bar=document.getElementById('cookieBar'); if(!bar) return;
  bar.hidden=false;
  var ok=document.getElementById('cookieOk');
  if(ok) ok.addEventListener('click',function(){ try{localStorage.setItem('gb-cookie-ok','1');}catch(e){} bar.hidden=true; });
})();
</script>
