<script>
// Live-Praesenz: sanfter Heartbeat, damit "gerade online" im Admin stimmt.
// Pausiert bei verstecktem Tab; sendet sofort beim Zurueckkehren.
(function(){
  var INTERVAL = 60000, last = 0, timer = null;
  function ping(){
    if (document.visibilityState !== 'visible') return;
    last = Date.now();
    try { fetch('/aktiv', { method:'GET', cache:'no-store', keepalive:true }).catch(function(){}); } catch(e){}
  }
  function start(){ if (timer) return; ping(); timer = setInterval(ping, INTERVAL); }
  function stop(){ if (timer){ clearInterval(timer); timer = null; } }
  document.addEventListener('visibilitychange', function(){
    if (document.visibilityState === 'visible'){ if (Date.now()-last > 30000) ping(); start(); }
    else stop();
  });
  start();
})();
</script>
<!-- Cookie-Einwilligung (Consent) mit Akzeptieren / Ablehnen -->
<div class="cc-card" id="ccBar" hidden role="dialog" aria-label="Datenschutz-Einstellungen">
  <span class="cc-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
  <div class="cc-head">Datenschutz &amp; Cookies</div>
  <p class="cc-body">Wir verwenden notwendige Cookies, damit Warenkorb und Login funktionieren. Mit &bdquo;Alle akzeptieren&ldquo; erlauben Sie zus&auml;tzlich Statistik- und Marketing-Cookies (z.&nbsp;B. von Google), sobald diese eingesetzt werden. Ihre Wahl k&ouml;nnen Sie jederzeit &uuml;ber &bdquo;Cookie-Einstellungen&ldquo; im Fu&szlig;bereich &auml;ndern. Mehr in der <a href="/datenschutz">Datenschutzerkl&auml;rung</a>.</p>
  <div class="cc-actions">
    <button type="button" class="cc-btn cc-decline" id="ccDecline">Nur notwendige</button>
    <button type="button" class="cc-btn cc-accept" id="ccAccept">Alle akzeptieren</button>
  </div>
</div>
<script>
(function(){
  var KEY='ah-consent';
  var bar=document.getElementById('ccBar'); if(!bar) return;
  var choice=null; try{choice=localStorage.getItem(KEY);}catch(e){}
  function grant(){ if(typeof gtag==='function'){ gtag('consent','update',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'}); } }
  if(!choice){ bar.hidden=false; }
  var a=document.getElementById('ccAccept'), d=document.getElementById('ccDecline');
  if(a) a.addEventListener('click',function(){ try{localStorage.setItem(KEY,'all');}catch(e){} grant(); bar.hidden=true; });
  if(d) d.addEventListener('click',function(){ try{localStorage.setItem(KEY,'necessary');}catch(e){} bar.hidden=true; });
  document.addEventListener('click',function(e){ var t=e.target.closest && e.target.closest('[data-cc-open]'); if(t){ e.preventDefault(); bar.hidden=false; } });
})();
</script>
