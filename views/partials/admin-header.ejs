<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Admin' %> · Agrarhero</title>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="stylesheet" href="/css/styles.css">
<script>(function(){try{if(localStorage.getItem('gb-theme')==='dark')document.documentElement.classList.add('dark');}catch(e){}})();</script>
</head>
<body class="admin-body">
<div class="admin-top">
  <div class="wrap">
    <a class="brand" href="/admin">AGRARHERO — <span style="color:#c7ccd4;font-weight:500">Admin</span></a>
    <nav>
      <a href="/admin" class="<%= (currentPath === '/admin' || currentPath.indexOf('/admin/bestellung') === 0) ? 'nav-active' : '' %>">Bestellungen</a>
      <a href="/admin/kunden" class="<%= currentPath.indexOf('/admin/kunden') === 0 ? 'nav-active' : '' %>">Kunden</a>
      <a href="/admin/produkte" class="<%= currentPath.indexOf('/admin/produkte') === 0 ? 'nav-active' : '' %>">Produkte</a>
      <a href="/admin/statistik" class="<%= currentPath.indexOf('/admin/statistik') === 0 ? 'nav-active' : '' %>">Statistik</a>
      <a href="/admin/einstellungen" class="<%= currentPath.indexOf('/admin/einstellungen') === 0 ? 'nav-active' : '' %>">Einstellungen</a>
      <button type="button" class="theme-toggle" aria-label="Hell/Dunkel umschalten" title="Hell/Dunkel umschalten"><svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg><svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6 19 19M19 5l-1.4 1.4M6.4 17.6 5 19"/></svg></button>
      <a href="/" target="_blank">Shop ansehen ↗</a>
      <form method="post" action="/logout" style="display:inline"><button class="btn btn-sm" style="background:#2e3742;color:#fff" type="submit">Abmelden</button></form>
    </nav>
  </div>
</div>
<% if (flash) { %><div class="wrap" style="padding-top:16px"><div class="flash <%= flash.type %>" style="margin:0"><%= flash.msg %></div></div><% } %>
<div class="admin-main">
  <div class="wrap">
