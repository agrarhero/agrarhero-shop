<%- include('partials/header') %>
<div class="page-head">
  <div class="wrap">
    <div class="crumb"><a href="/">Start</a> › Karriere</div>
    <h1>Karriere bei Agrarhero</h1>
    <p class="head-sub">Werden Sie Teil unseres Teams – wir wachsen und suchen Verstärkung für unser Lager.</p>
  </div>
</div>

<section class="block">
  <div class="wrap narrow">
    <div class="job-card">
      <div class="job-head">
        <div>
          <span class="job-badge">Vollzeit · ab 01.08.2026</span>
          <h2>Lagermitarbeiter (m/w/d)</h2>
          <p class="job-loc">Deutschland · Präsenz im Lager</p>
        </div>
      </div>

      <p class="job-intro">Zur Verstärkung unseres Teams suchen wir zum <strong>01.08.2026</strong> zuverlässige Lagermitarbeiter (m/w/d) in <strong>Vollzeit</strong>. Sie sorgen dafür, dass unsere Agrartechnik schnell und sauber zu unseren Kunden gelangt.</p>

      <div class="job-grid">
        <div>
          <h3>Ihre Aufgaben</h3>
          <ul class="job-list">
            <li>Warenannahme, Kommissionierung und Versandvorbereitung</li>
            <li>Be- und Entladen von Lieferungen (Stapler / Hubwagen)</li>
            <li>Bestandskontrolle und Ordnung im Lager</li>
            <li>Qualitätsprüfung der Neuware vor dem Versand</li>
          </ul>
        </div>
        <div>
          <h3>Ihr Profil</h3>
          <ul class="job-list">
            <li>Zuverlässige, sorgfältige und teamorientierte Arbeitsweise</li>
            <li>Idealerweise Erfahrung in Lager oder Logistik</li>
            <li>Staplerschein von Vorteil (kein Muss)</li>
            <li>Körperliche Belastbarkeit</li>
          </ul>
        </div>
      </div>

      <h3>Wir bieten</h3>
      <ul class="job-list">
        <li>Unbefristete Festanstellung in Vollzeit mit fairer, pünktlicher Vergütung</li>
        <li>Sicherer Arbeitsplatz in einem wachsenden Unternehmen</li>
        <li>Kurze Entscheidungswege und ein kollegiales Team</li>
        <li>Moderne Arbeitsmittel und geregelte Arbeitszeiten</li>
      </ul>

      <div class="job-cta">
        <div>
          <h3 style="margin:0">Jetzt direkt bewerben</h3>
          <p style="margin:4px 0 0;color:var(--muted);font-size:.9rem">Senden Sie uns Ihre Bewerbung – unkompliziert per E-Mail. Wir melden uns zeitnah bei Ihnen.</p>
        </div>
        <a class="btn btn-accent" href="mailto:bewerbung@agrarhero.de?subject=Bewerbung%20Lagermitarbeiter%20(m/w/d)">Jetzt bewerben ▸</a>
      </div>
      <p class="job-alt">Lieber über das Kontaktformular? <a href="/kontakt">Hier entlang</a>.</p>
    </div>
  </div>
</section>
