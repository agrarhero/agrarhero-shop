<%- include('partials/header') %>
<% var typ = (form && form.customer_type === 'privat') ? 'privat' : 'firma'; function v(k){ return (form && form[k]) ? form[k] : ''; } %>
<div class="page-head"><div class="wrap"><div class="crumb"><a href="/login">Anmelden</a> › Konto erstellen</div><h1>Konto erstellen</h1></div></div>

<section class="block">
  <div class="wrap narrow">
    <div class="form-card">
      <% if (error) { %><div class="flash error" style="margin:0 0 16px"><%= error %></div><% } %>
      <form method="post" action="/registrieren" id="regForm" data-validate>

        <!-- Umschalter Firma / Privat -->
        <div class="section-title" style="margin-top:0">Kontotyp</div>
        <div class="seg" id="typeSeg">
          <label class="seg-opt <%= typ==='firma'?'active':'' %>">
            <input type="radio" name="customer_type" value="firma" <%= typ==='firma'?'checked':'' %>>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 21h18"/><path d="M5 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16"/><path d="M15 9h3a1 1 0 0 1 1 1v11"/><path d="M8 8h2M8 12h2M8 16h2"/></svg>Firma</span>
          </label>
          <label class="seg-opt <%= typ==='privat'?'active':'' %>">
            <input type="radio" name="customer_type" value="privat" <%= typ==='privat'?'checked':'' %>>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>Privat</span>
          </label>
        </div>

        <!-- Firma-Felder -->
        <div id="firmaFields" class="firma-only">
          <div class="field"><label>Firmenname *</label><input name="company" value="<%= v('company') %>"></div>
          <div class="field"><label>USt-IdNr. (optional)</label><input name="ustid" value="<%= v('ustid') %>" placeholder="z. B. DE123456789"><div class="form-note">Nur nötig für innergemeinschaftliche EU-Rechnungen – für die Registrierung nicht erforderlich.</div></div>
        </div>

        <div class="section-title">Ansprechpartner</div>
        <div class="grid3">
          <div class="field"><label>Anrede *</label>
            <select name="salutation" required>
              <% var sal=v('salutation'); %>
              <option value="" <%= !sal?'selected':'' %> disabled>Bitte wählen</option>
              <option value="Herr" <%= sal==='Herr'?'selected':'' %>>Herr</option>
              <option value="Frau" <%= sal==='Frau'?'selected':'' %>>Frau</option>
              <option value="Divers" <%= sal==='Divers'?'selected':'' %>>Divers</option>
            </select>
          </div>
          <div class="field"><label>Vorname *</label><input name="first_name" value="<%= v('first_name') %>" required></div>
          <div class="field"><label>Nachname *</label><input name="last_name" value="<%= v('last_name') %>" required></div>
        </div>

        <div class="section-title">Rechnungsadresse</div>
        <div class="field"><label>Straße & Hausnummer *</label><input name="street" value="<%= v('street') %>" required></div>
        <div class="grid3">
          <div class="field"><label>PLZ *</label><input name="zip" value="<%= v('zip') %>" required></div>
          <div class="field"><label>Ort *</label><input name="city" value="<%= v('city') %>" required></div>
          <div class="field"><label>Land *</label><input name="country" value="<%= v('country') || 'Deutschland' %>" required></div>
        </div>
        <div class="grid2">
          <div class="field"><label>Telefon *</label><input name="phone" value="<%= v('phone') %>" required></div>
          <div class="field"><label>E-Mail *</label><input type="email" name="email" value="<%= v('email') %>" required></div>
        </div>

        <div class="section-title">Lieferadresse</div>
        <label class="checkline" style="margin-bottom:2px">
          <input type="checkbox" name="ship_diff" id="shipDiff" value="ja" <%= v('ship_street') ? 'checked' : '' %>>
          <span>Abweichende Lieferadresse angeben – falls die Ware an eine andere Anschrift geliefert werden soll als die Rechnung.</span>
        </label>
        <div id="shipFields" class="ship-fields">
              <p class="form-note" style="margin:0 0 8px">Empfängername ist optional – bleibt das Feld leer, liefern wir an den bereits oben angegebenen Namen (bei Firmenkunden an Firma und Ansprechpartner).</p>
          <div class="grid2">
            <div class="field"><label>Vorname Empfänger (optional)</label><input name="ship_first_name" value="<%= v('ship_first_name') %>"></div>
            <div class="field"><label>Nachname Empfänger (optional)</label><input name="ship_last_name" value="<%= v('ship_last_name') %>"></div>
          </div>
          <div class="field"><label>Firma (optional)</label><input name="ship_company" value="<%= v('ship_company') %>"></div>
          <div class="field"><label>Straße & Hausnummer</label><input name="ship_street" value="<%= v('ship_street') %>"></div>
          <div class="grid3">
            <div class="field"><label>PLZ</label><input name="ship_zip" value="<%= v('ship_zip') %>"></div>
            <div class="field"><label>Ort</label><input name="ship_city" value="<%= v('ship_city') %>"></div>
            <div class="field"><label>Land</label><input name="ship_country" value="<%= v('ship_country') || 'Deutschland' %>"></div>
          </div>
        </div>

        <div class="section-title">Zugangsdaten</div>
        <div class="grid2">
          <div class="field"><label>Passwort *</label><input type="password" name="password" required minlength="8"><div class="form-note">Mind. 8 Zeichen mit Groß- und Kleinbuchstaben, einer Zahl und einem Sonderzeichen.</div></div>
          <div class="field"><label>Passwort wiederholen *</label><input type="password" name="password2" required></div>
        </div>

        <label class="checkline">
          <input type="checkbox" name="agb" value="ja" required>
          <span>Ich akzeptiere die <a href="/agb" target="_blank">AGB</a> und habe die <a href="/datenschutz" target="_blank">Datenschutzerklärung</a> gelesen. *</span>
        </label>

        <button class="btn btn-accent btn-block" type="submit" style="margin-top:8px">Konto erstellen</button>
        <p class="form-note" style="margin-top:12px">Bereits registriert? <a href="/login" style="color:var(--accent);font-weight:600">Hier anmelden</a></p>
      </form>
    </div>
  </div>
</section>

<script>
  (function(){
    var seg = document.getElementById('typeSeg');
    var firma = document.getElementById('firmaFields');
    var companyInput = firma.querySelector('input[name="company"]');
    function apply(){
      var val = seg.querySelector('input[name="customer_type"]:checked').value;
      seg.querySelectorAll('.seg-opt').forEach(function(o){ o.classList.toggle('active', o.querySelector('input').checked); });
      var isFirma = (val === 'firma');
      firma.style.display = isFirma ? '' : 'none';
      if (companyInput) companyInput.required = isFirma;
    }
    seg.querySelectorAll('input[name="customer_type"]').forEach(function(r){ r.addEventListener('change', apply); });
    apply();
  })();
  (function(){
    var cb = document.getElementById('shipDiff');
    var box = document.getElementById('shipFields');
    if (!cb || !box) return;
    var req = ['ship_street','ship_zip','ship_city'];
    function apply(){
      box.style.display = cb.checked ? '' : 'none';
      req.forEach(function(n){ var el = box.querySelector('[name="'+n+'"]'); if (el) el.required = cb.checked; });
    }
    cb.addEventListener('change', apply);
    apply();
  })();
</script>
<%- include('partials/footer') %>
